<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- xUnit1051 asks to pass TestContext's token to every API taking one; the library's own token parameters are what is under test. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="../../src/SharpCell/SharpCell.csproj" />
    <ProjectReference Include="../../src/SharpCell.Xlsx/SharpCell.Xlsx.csproj" />
    <ProjectReference Include="../../tools/SharpCell.Conformance/SharpCell.Conformance.csproj" />
    <ProjectReference Include="../../tools/SharpCell.Docs/SharpCell.Docs.csproj" />
    <ProjectReference Include="../../samples/SharpCell.Sample/SharpCell.Sample.csproj" />
  </ItemGroup>
</Project>
