<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>SharpCell</RootNamespace>
    <Description>Excel formula engine for .NET: 465 functions, dependency graph, recalculation, dynamic arrays, LET/LAMBDA, tables, custom functions, changed cells, cloning workbooks.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt;PublicAPI.Unshipped.txt" />
    <InternalsVisibleTo Include="SharpCell.Tests" />
    <InternalsVisibleTo Include="SharpCell.Xlsx" />
    <InternalsVisibleTo Include="SharpCell.Conformance" />
  </ItemGroup>
</Project>
